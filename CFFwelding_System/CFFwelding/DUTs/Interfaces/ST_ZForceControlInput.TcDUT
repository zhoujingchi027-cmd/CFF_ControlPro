<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_ZForceControlInput" Id="{D2000000-0000-4000-8000-000000000001}"><Declaration><![CDATA[TYPE ST_ZForceControlInput :
STRUCT
    (* 力控制使能请求，由快速流程唯一写入。 *)
    bEnable : BOOL;
    (* 力控制复位请求，仅用于清除算法内部状态。 *)
    bReset : BOOL;
    (* 当前步骤的压向目标力，单位kN。 *)
    rForceSet_kN : LREAL;
    (* 低延迟压向实际力，单位kN。 *)
    rForceActual_kN : LREAL;
    (* 从Contact起累计的工艺相对位移，向下为正，单位mm。 *)
    rRelativePosition_mm : LREAL;
    (* 本次算法调用的实际周期，单位s。 *)
    rCycleTime_s : LREAL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
