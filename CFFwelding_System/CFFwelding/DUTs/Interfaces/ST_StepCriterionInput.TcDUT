<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_StepCriterionInput" Id="{D2000000-0000-4000-8000-000000000011}"><Declaration><![CDATA[TYPE ST_StepCriterionInput :
STRUCT
    (* 当前步骤判据使能请求。 *)
    bEnable : BOOL;
    (* 当前步骤判据锁存复位请求。 *)
    bReset : BOOL;
    (* 当前步骤唯一主结束判据。 *)
    ePrimaryCriterion : E_StepPrimaryCriterion;
    (* 从接触点起累计的工艺相对位移，单位毫米。 *)
    rRelativePosition_mm : LREAL;
    (* 相对位移主判据目标，单位毫米。 *)
    rRelativeDistanceTarget_mm : LREAL;
    (* 当前步骤累计时间，单位秒。 *)
    rStepTime_s : LREAL;
    (* 时间主判据目标，单位秒。 *)
    rStepTimeTarget_s : LREAL;
    (* 当前步骤实际轴向力，单位千牛。 *)
    rForceActual_kN : LREAL;
    (* 力下降结束阈值，单位千牛。 *)
    rDeclineTo_kN : LREAL;
    (* 力下降预装配阈值，单位千牛。 *)
    rArmForce_kN : LREAL;
    (* 力变化率，下降为负，单位千牛每秒。 *)
    rForceDerivative_kN_s : LREAL;
    (* 非位移主判据使用的次级相对位移硬限制，单位毫米。 *)
    rSecondaryDistanceLimit_mm : LREAL;
    (* 转速、相对位移和采样窗口均有效。 *)
    bWindowValid : BOOL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
