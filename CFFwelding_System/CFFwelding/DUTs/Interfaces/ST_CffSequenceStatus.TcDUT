<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_CffSequenceStatus" Id="{D2000000-0000-4000-8000-000000000014}"><Declaration><![CDATA[TYPE ST_CffSequenceStatus :
STRUCT
    (* 最近接受并开始处理的事务编号。 *)
    nAcceptedCommandId : UDINT;
    (* CFF 周期正在执行。 *)
    bBusy : BOOL;
    (* CFF 周期正常完成并等待上层确认。 *)
    bDone : BOOL;
    (* CFF 周期已按停止或中止请求退出。 *)
    bAborted : BOOL;
    (* CFF 流程报告不合格或故障。 *)
    bError : BOOL;
    (* 流程错误编号，零表示无错误。 *)
    nErrorId : UDINT;
    (* CFF 主状态。 *)
    eState : E_CffState;
    (* 当前正式工艺步骤。 *)
    eStep : E_CffStep;
    (* 当前步骤子阶段。 *)
    eSubPhase : E_StepSubPhase;
    (* 最近步骤结束原因。 *)
    eEndCause : E_StepEndCause;
    (* 当前流程目标轴向力，单位千牛。 *)
    rForceSet_kN : LREAL;
    (* 当前流程目标主轴速度，单位转每分钟。 *)
    rSpeedSet_rpm : LREAL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
