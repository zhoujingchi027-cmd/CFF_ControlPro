<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_StepCriterionOutput" Id="{D2000000-0000-4000-8000-000000000012}"><Declaration><![CDATA[TYPE ST_StepCriterionOutput :
STRUCT
    (* 力下降判据已经达到预装配力并进入可确认窗口。 *)
    bArmed : BOOL;
    (* 主判据已经满足。 *)
    bPrimaryMet : BOOL;
    (* 次级相对位移限制已经触发。 *)
    bSecondaryLimitReached : BOOL;
    (* 当前步骤结束已经防抖确认。 *)
    bEndConfirmed : BOOL;
    (* Primary满足时步骤时间低于StepMin。 *)
    bTooShort : BOOL;
    (* 当前结束原因要求周期或步骤判为不合格。 *)
    bNok : BOOL;
    (* Secondary AdvanceAndNok允许进入下一步骤。 *)
    bAdvanceRequested : BOOL;
    (* Secondary、StepMax或硬原因要求受控退出。 *)
    bControlledExitRequested : BOOL;
    (* 当前结束原因要求立即禁止继续向下。 *)
    bDownwardMotionInhibited : BOOL;
    (* 步骤实际结束原因。 *)
    eEndCause : E_StepEndCause;
    (* 结束确认时锁存的轴向力，单位千牛。 *)
    rLatchedForce_kN : LREAL;
    (* 结束确认时锁存的相对位移，单位毫米。 *)
    rLatchedRelativePosition_mm : LREAL;
    (* 结束确认时锁存的步骤时间，单位秒。 *)
    rLatchedStepTime_s : LREAL;
    (* 输入、配置或未知枚举故障。 *)
    bFault : BOOL;
    (* 确定性故障编号，零表示无故障。 *)
    nFaultId : UDINT;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
