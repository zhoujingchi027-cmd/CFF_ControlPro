<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_ZExtSetpointCommand" Id="{D2000000-0000-4000-8000-000000000003}"><Declaration><![CDATA[TYPE ST_ZExtSetpointCommand :
STRUCT
    (* 请求清除已完成或未激活生命周期的错误状态。 *)
    bReset : BOOL;
    (* 请求进入External Setpoint生命周期。 *)
    bEnable : BOOL;
    (* 请求在当前周期发送P/V/A/Direction设定值。 *)
    bFeed : BOOL;
    (* 请求受控退出External Setpoint生命周期。 *)
    bDisable : BOOL;
    (* 外部位置设定值，向下为正，单位mm。 *)
    rPosition_mm : LREAL;
    (* 外部速度设定值，向下为正，单位mm/s。 *)
    rVelocity_mm_s : LREAL;
    (* 外部加速度设定值，向下为正，单位mm/s2。 *)
    rAcceleration_mm_s2 : LREAL;
    (* 方向命令，只允许-1、0或1。 *)
    nDirection : DINT;
    (* 强制禁止向正方向运动。 *)
    bPositiveMotionInhibit : BOOL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
