<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_ContactDetectInput" Id="{D2000000-0000-4000-8000-000000000009}"><Declaration><![CDATA[TYPE ST_ContactDetectInput :
STRUCT
    (* Contact检测使能请求。 *)
    bEnable : BOOL;
    (* Contact检测复位请求。 *)
    bReset : BOOL;
    (* 当前压向实际力，单位kN。 *)
    rForceActual_kN : LREAL;
    (* Contact力阈值，单位kN。 *)
    rForceThreshold_kN : LREAL;
    (* 当前Z轴位置，向下为正，单位mm。 *)
    rAxisPosition_mm : LREAL;
    (* 当前Z轴速度，向下为正，单位mm/s。 *)
    rAxisVelocity_mm_s : LREAL;
    (* 输入采样有效。 *)
    bSignalValid : BOOL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
