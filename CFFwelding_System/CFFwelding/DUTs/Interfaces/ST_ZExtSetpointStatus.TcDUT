<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_ZExtSetpointStatus" Id="{D2000000-0000-4000-8000-000000000004}"><Declaration><![CDATA[TYPE ST_ZExtSetpointStatus :
STRUCT
    (* 外部设定值接口已经成功使能。 *)
    bEnabled : BOOL;
    (* 适配器正在执行使能、送值或禁用阶段。 *)
    bBusy : BOOL;
    (* 本次生命周期正常完成。 *)
    bDone : BOOL;
    (* 当前扫描成功写入P/V/A/Direction。 *)
    bFeedAccepted : BOOL;
    (* External已完整退出，允许Owner转交标准NC。 *)
    bReleaseOwner : BOOL;
    (* 运动控制接口或生命周期诊断报告错误。 *)
    bError : BOOL;
    (* 运动控制错误编号，零表示无错误。 *)
    nErrorId : UDINT;
    (* 外部设定值生命周期状态。 *)
    eState : E_ZExtSetpointState;
    (* 已执行的External Feed周期计数。 *)
    udiFeedCycleCounter : UDINT;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
