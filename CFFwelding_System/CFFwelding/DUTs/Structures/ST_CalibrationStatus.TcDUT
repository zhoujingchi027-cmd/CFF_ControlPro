<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_CalibrationStatus" Id="{D3100000-0000-4000-8000-000000000029}"><Declaration><![CDATA[TYPE ST_CalibrationStatus : STRUCT
    (* 已接受的标定请求编号。 *)
