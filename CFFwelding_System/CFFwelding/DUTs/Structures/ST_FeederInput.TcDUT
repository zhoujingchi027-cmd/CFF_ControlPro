<TcPlcObject Version="1.1.0.1"><DUT Name="ST_FeederInput" Id="{D3100000-0000-4000-8000-000000000026}"><Declaration><![CDATA[TYPE ST_FeederInput : STRUCT
    (* 供料器就绪反馈。 *)
    bReady : BOOL;
    (* 紧固件在位传感器。 *)
