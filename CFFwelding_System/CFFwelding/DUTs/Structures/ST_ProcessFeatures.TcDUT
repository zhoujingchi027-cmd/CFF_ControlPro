<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_ProcessFeatures" Id="{D3100000-0000-4000-8000-000000000016}"><Declaration><![CDATA[TYPE ST_ProcessFeatures : STRUCT
    (* 周期最大力，单位牛顿。 *)
    fMaxForceN : LREAL;
    (* 周期平均力，单位牛顿。 *)
    fMeanForceN : LREAL;
    (* 周期最大扭矩，单位牛米。 *)
    fMaxTorqueNm : LREAL;
    (* 周期平均扭矩，单位牛米。 *)
    fMeanTorqueNm : LREAL;
    (* 周期最终相对位移，单位毫米。 *)
    fFinalRelativeDistanceMm : LREAL;
    (* 周期累计能量，单位焦耳。 *)
    fEnergyJ : LREAL;
    (* 有效采样数量。 *)
    nSampleCount : UDINT;
    (* 特征提取结果是否有效。 *)
    bValid : BOOL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
