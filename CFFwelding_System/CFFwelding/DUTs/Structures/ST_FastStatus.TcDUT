<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_FastStatus" Id="{D3100000-0000-4000-8000-000000000031}"><Declaration><![CDATA[TYPE ST_FastStatus : STRUCT
    (* 快速任务已接受的命令请求编号。 *)
    nAcceptedRequestId : UDINT;
    (* 快速任务循环计数。 *)
    nCycleCounter : UDINT;
    (* 快速任务实际周期，单位微秒。 *)
    nActualPeriodUs : UDINT;
    (* CFF 顺序状态。 *)
    stSequence : ST_CffSequenceStatus;
    (* Z 轴状态。 *)
    stZAxis : ST_ZAxisStatus;
    (* Z轴External Setpoint生命周期状态。 *)
    stZExtSetpoint : ST_ZExtSetpointStatus;
    (* Z轴External轨迹状态。 *)
    stZExternalTrajectory : ST_ZExternalTrajectoryOutput;
    (* 已接受的Sequence Z轴命令事务号。 *)
    udiAcceptedSequenceZCommandId : UDINT;
    (* 已接受的Sequence R轴命令事务号。 *)
    udiAcceptedSequenceRCommandId : UDINT;
    (* Z轴导纳力控速度和Anti-windup诊断。 *)
    stZForceControl : ST_ZForceControlOutput;
    (* R 轴状态。 *)
    stRAxis : ST_RAxisStatus;
    (* R轴转速包络，单位转每分钟。 *)
    rRSpeedEnvelope_rpm : LREAL;
    (* R轴转速斜坡正在执行。 *)
    bRSpeedRampBusy : BOOL;
    (* R轴转速斜坡已经达到目标。 *)
    bRSpeedRampReached : BOOL;
    (* R轴转速斜坡参数有效。 *)
    bRSpeedRampValid : BOOL;
    (* 力设定值斜坡已经达到目标。 *)
    bForceSetpointRampReached : BOOL;
    (* 力设定值斜坡参数有效。 *)
    bForceSetpointRampValid : BOOL;
    (* 快速过程实际值。 *)
    stProcess : ST_ProcessActual;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
