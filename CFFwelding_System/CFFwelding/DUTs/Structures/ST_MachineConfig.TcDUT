<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><DUT Name="ST_MachineConfig" Id="{D3100000-0000-4000-8000-000000000001}"><Declaration><![CDATA[TYPE ST_MachineConfig : STRUCT
    (* 配置修订号，用于快照一致性检查。 *)
    nRevision : UDINT;
    (* 快速任务周期，单位微秒。 *)
    nFastTaskCycleUs : UDINT;
    (* 主任务周期，单位微秒。 *)
    nMainTaskCycleUs : UDINT;
    (* 慢速任务周期，单位微秒。 *)
    nSlowTaskCycleUs : UDINT;
    (* 当前工具标识。 *)
    nToolId : UDINT;
    (* 当前砧座标识。 *)
    nAnvilId : UDINT;
    (* 机器配置是否已通过工程确认。 *)
    bValid : BOOL;
END_STRUCT
END_TYPE
]]></Declaration></DUT></TcPlcObject>
