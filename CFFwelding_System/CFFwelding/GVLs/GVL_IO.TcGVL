    (* TODO_HW_MAP：红色塔灯输出，当前未映射。 *)
    bTowerRed AT %Q* : BOOL;
    (* TODO_HW_MAP：黄色塔灯输出，当前未映射。 *)
    bTowerYellow AT %Q* : BOOL;
    (* TODO_HW_MAP：绿色塔灯输出，当前未映射。 *)
