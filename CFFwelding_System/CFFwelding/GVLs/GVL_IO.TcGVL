    (* R 轴 PLC 运动控制引用；仅允许连接离线 NC 轴，不绑定真实驱动。 *)
    R_axis : AXIS_REF;

    (* TODO_HW_MAP：力传感器原始输入通道，当前未映射。 *)
    nForceChannelRaw AT %I* : INT;
    (* TODO_HW_MAP：位移传感器原始输入通道，当前未映射。 *)
    nDisplacementChannelRaw AT %I* : INT;
    (* TODO_HW_MAP：碰撞检测输入，当前未映射。 *)
    bCollisionDetected AT %I* : BOOL;
    (* TODO_HW_MAP：紧固件在位输入，当前未映射。 *)
    bFastenerPresent AT %I* : BOOL;
    (* TODO_HW_MAP：供料器就绪输入，当前未映射。 *)
    bFeederReady AT %I* : BOOL;
    (* TODO_HW_MAP：夹紧到位输入，当前未映射。 *)
    bClampClosed AT %I* : BOOL;
    (* TODO_HW_MAP：机器人许可输入，当前未映射。 *)
