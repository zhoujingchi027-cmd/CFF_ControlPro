<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><GVL Name="GVL_Config" Id="{C3100000-0000-4000-8000-000000000003}"><Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    (* 当前机器配置。 *)
    stMachine : ST_MachineConfig;
    (* 当前机器运动和过程限值。 *)
    stLimits : ST_MachineLimits;
    (* 当前 Z 轴力控制参数。 *)
    stZForceControl : ST_ZForceControlProfile;
    (* 当前 R 轴参数。 *)
    stRAxis : ST_RAxisProfile;
    (* 当前快速传感器滤波、范围和诊断参数。 *)
    stSensorProcessing : ST_SensorProcessingConfig;
    (* Z轴External Setpoint超时、连续性和退出保持参数。 *)
    stZExtSetpoint : ST_ZExtSetpointConfig;
    (* CFF流程超时和标准定位斜率；默认无效。 *)
    stCffSequence : ST_CffSequenceConfig;
END_VAR
]]></Declaration></GVL></TcPlcObject>
