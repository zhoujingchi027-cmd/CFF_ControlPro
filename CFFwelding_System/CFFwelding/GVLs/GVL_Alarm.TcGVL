<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><GVL Name="GVL_Alarm" Id="{C3100000-0000-4000-8000-000000000009}"><Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    (* 各功能块发布的报警请求槽。 *)
